{
  "spec_version": "2.0",
  "architecture_name": "torus_rotation_compositor",
  "novel_component": {
    "type": "modular_arithmetic",
    "class": "circular_embedding_composition",
    "ops_used": [
      "frequency_circular_embed",
      "rotation_compose",
      "prime_harmonic_gate",
      "geodesic_classify"
    ]
  },
  "composition": {
    "strategy": "sequential",
    "hybrid_ratio": 1.0,
    "num_layers": 4,
    "layer_arrangement": [
      {
        "layer": 1,
        "op": "frequency_circular_embed",
        "applied_to": [
          "a",
          "b"
        ],
        "shared_weights": true,
        "output_dim": 64,
        "description": "a -> (cos(a*omega_k+phi_k), sin(a*omega_k+phi_k)) for k=1..K"
      },
      {
        "layer": 2,
        "op": "rotation_compose",
        "input": "layer1_outputs",
        "output_dim": 64,
        "learned_params": 0,
        "description": "complex multiplication per circle"
      },
      {
        "layer": 3,
        "op": "prime_harmonic_gate",
        "input": [
          "layer2_output",
          "p"
        ],
        "output_dim": 64,
        "description": "w(p) element-wise scaling of K circle outputs"
      },
      {
        "layer": 4,
        "op": "geodesic_classify",
        "input": "layer3_output",
        "shared_embed": "layer1",
        "output_dim": "p",
        "description": "score(c) = sum_k w_k(p) * cos(delta_theta_k(c)), scaled by temperature"
      }
    ]
  },
  "hyperparameters": {
    "num_circles": 32,
    "embedding_dim": 64,
    "frequency_init": "evenly_spaced_0_to_2pi",
    "temperature_init": 1.0,
    "total_parameters": 353
  }
}